# Copy to .env (git-ignored); mise loads it for every task.
#
# This file holds no secret and no application setting: those live in config/
# (see config/example/). It only says which environment and which AWS profile
# THIS machine uses, and which agent the chat page of THIS machine calls.

# The current environment (dev, tst, prd) of one.config / one.bsm when nothing else sets it;
# each cdk-<action>-<env>-* task sets its own. Defaults to dev.
ENV_NAME="dev"
# The AWS CLI profile of each environment, as named in your own ~/.aws/config (differs per
# person, so it lives here, not in mise.toml). The cdk-plan/up/down-<env>-* tasks pass it as
# --profile and stop if it is not set; one.bsm uses the one of the current environment.
AWS_PROFILE_FOR_DEV="your_dev_aws_profile_name"
AWS_PROFILE_FOR_TST="your_tst_aws_profile_name"
AWS_PROFILE_FOR_PRD="your_prd_aws_profile_name"

# Which AuditAgent the chat page calls (app/api/chat/route.ts, lib/agent/invoke.ts). Next.js
# reads the same two variables from .env.local, and a hosting platform from its own settings.
# The deployed runtime: arn:aws:bedrock-agentcore:<region>:<account>:runtime/<runtime ID>, the
# runtime ID being the "AgentCore runtime, AuditAgent" entry of QUICK_LINKS.md. The call is
# signed with the AWS SDK's default credentials: AWS_PROFILE when set, else the profile
# named "default".
AGENTCORE_RUNTIME_AUDITAGENT_ARN="arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/AgentAudit_dev_AuditAgent-0000000000"
# On Vercel only, never in this file: AWS_ROLE_ARN, the role of the web-invoker stack. With it
# set, the call is signed with temporary credentials Vercel's OIDC token is exchanged for.
# On Vercel, and here only to try it: the daily limit of the chat page (lib/agent/daily-count.ts).
# CHAT_DAILY_TABLE_ARN is the table of the web-invoker stack
# (arn:aws:dynamodb:<region>:<account>:table/<project>-<env>-chat-daily-count) and
# CHAT_DAILY_LIMIT how many questions a day the page passes to the agent, all readers
# together. Without the first one, a developer machine counts nothing.
# A runtime on this machine instead (mise run ac-local-audit-agent); it wins over the ARN.
# agent_app/devtools/agent_client.py reads it too. Leave it commented out to call the deployed one.
# AGENT_URL="http://127.0.0.1:18734"
