// Copy to config/config-shared-secret.json5 (git-ignored) and fill in real values.
// Secrets shared by every environment, merged after config-shared.json5.
// Every key must be a field of Config (config_00_main.py).
{
  // The slug of the Vercel team that hosts the web app: the last part of the team's URL,
  // https://vercel.com/<slug>. Not a credential, but it names an account, so it stays out of Git.
  vercel_team_slug: "acme-team",
}
