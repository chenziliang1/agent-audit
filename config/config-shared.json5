// Settings shared by every environment. Overridden by config-<env>.json5.
// Shape and docs of every file: config/example/. Fields: Config in config_00_main.py.
{
  // Every AWS resource name derives from this, such as the stack name prefix.
  project_name: "agent_audit",
  // The AgentCore CLI project name: a letter, then letters and digits, at most 23 characters.
  // Every AgentCore resource name starts with it, such as AgentAudit_dev_AuditMcp.
  agentcore_project_name: "AgentAudit",
  // The Claude model of the AuditAgent, called on the Anthropic API with the anthropic_api_key
  // of the -secret file; override it per environment if needed.
  audit_agent_model_id: "claude-sonnet-5-5",
  // The model a call is made again on when audit_agent_model_id refuses it and the Anthropic API
  // returns the refusal instead of falling back by itself. For a "cyber" refusal of
  // claude-sonnet-5-5 the API falls back to claude-sonnet-5, so this names the same model.
  audit_agent_fallback_model_id: "claude-sonnet-5",
  // The Vercel project that hosts the web app. Only its production deployments may assume the
  // role of the web-invoker stack; the team's slug, vercel_team_slug, is in the -secret file.
  vercel_project_name: "agent-audit",
  // The environment whose web-invoker stack creates the IAM OIDC provider of the Vercel team.
  // IAM allows one provider per issuer in an account, so the web-invoker stacks of the other
  // environments in that account refer to it. Never destroy that environment's stack while
  // another one is in use. With one AWS account per environment, each config-<env>.json5
  // names its own environment here.
  vercel_oidc_provider_env_name: "dev",
}
